# Intune Custom Compliance -- Environment Variables Template
# Copy to .env and fill in values. NEVER commit .env.

# Microsoft Intune (Azure AD App Registration)
# App Registration must have both Application permissions (admin consent required):
#   - DeviceManagementManagedDevices.Read.All
#   - DeviceManagementConfiguration.Read.All
INTUNE_TENANT_ID=
INTUNE_CLIENT_ID=
# Option A -- direct value (local dev / non-AWS environments):
INTUNE_CLIENT_SECRET=
# Option B -- AWS Secrets Manager (production): set this to the secret name or ARN.
# When set, INTUNE_CLIENT_SECRET above is ignored for that run.
# The IAM principal must have secretsmanager:GetSecretValue on this secret.
# INTUNE_CLIENT_SECRET_ID=

# Compliance Policy Mapping
# Set each value to the exact display name of the corresponding Intune
# compliance policy in your tenant (case-insensitive match).
# Omit any variable for a check type you have not configured -- that field
# will simply be absent from all Drata payloads.
POLICY_NAME_SCREEN_LOCK=
# POLICY_NAME_AUTO_UPDATES is a Windows Update Ring display name, NOT a compliance
# policy. It is resolved via /deviceManagement/windowsUpdateForBusinessConfigurations.
# Setting this to a compliance policy name will always produce a warning and no data.
POLICY_NAME_AUTO_UPDATES=
POLICY_NAME_PASSWORD_MANAGER=
POLICY_NAME_ENCRYPTION=
POLICY_NAME_ANTIVIRUS=

# Drata
# API key requires "Devices: Create Device" scope.
# Connection ID: Drata App -> Connections -> MDM -> Custom Device Connection -> Account Information
# Option A -- direct value (local dev / non-AWS environments):
DRATA_API_KEY=
# Option B -- AWS Secrets Manager (production): set this to the secret name or ARN.
# When set, DRATA_API_KEY above is ignored for that run.
# DRATA_API_KEY_ID=
DRATA_CONNECTION_ID=

# Optional
# Override the default state file location (defaults to ./drata_state.json)
STATE_FILE_PATH=
# Structured log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO
